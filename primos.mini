// Números primos hasta el límite (bucles anidados, condiciones y cadenas)
var limite: entero = 30;
var n: entero = 2;

mientras (n <= limite) {
    var esPrimo: booleano = verdadero;
    var d: entero = 2;
    mientras (d * d <= n) {
        si (n % d == 0) {
            esPrimo = falso;
        }
        d = d + 1;
    }
    si (esPrimo) {
        escribir("Primo: " + n);
    }
    n = n + 1;
}
